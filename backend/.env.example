# Anthropic API key — required. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model used for question generation, evaluation, and report writing
MODEL_NAME=claude-sonnet-4-6

# SQLite file used to persist interview sessions across restarts
DATABASE_PATH=interview_ai.db

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5173

# How many times to retry an LLM call that returns malformed JSON
MAX_LLM_RETRIES=3

ENV=development
