# OpenAI-compatible endpoint of the LLM server.
#   Ollama:    http://localhost:11434/v1   (default)
#   vLLM:      http://localhost:8000/v1
#   LM Studio: http://localhost:1234/v1
#   Groq:      https://api.groq.com/openai/v1
LLM_BASE_URL=http://localhost:11434/v1

# API key — only needed for hosted providers (Groq, OpenRouter, ...).
# Local servers ignore this value.
LLM_API_KEY=not-needed-for-local

# Open-source model served by the endpoint above. Examples for Ollama:
#   qwen2.5:7b | llama3.2 | llama3.1:8b | mistral | phi3
MODEL_NAME=qwen2.5:7b

# SQLite file used to persist interview sessions across restarts
DATABASE_PATH=interview_ai.db

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5173

# How many times to retry an LLM call that returns malformed JSON
MAX_LLM_RETRIES=3

ENV=development
